doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= title
        script(src="/bootstrap/js/bootstrap.bundle.min.js")
        script(src="/toastify/toastify.js")
        link(
            href="/bootstrap/css/bootstrap.min.css"
            rel="stylesheet"
        )
        link(rel="stylesheet" href="/toastify/toastify.css")
    body.bg-light
        main.container
            .row.justify-content-center.align-items-center.min-vh-100   
                .col-12.col-md-6.col-lg-4
                    .card.shadow-sm.border-0.rounded-4
                        .card-body.p-4
                            h1.display-6.mb-3 
                            | Bienvenido 
                            span.text-primary= currentUser.username