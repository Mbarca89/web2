extends /layouts/main

block content
  main.container.py-5
    .row.g-4
      .col-12.col-lg-4
        .card.border-0.shadow-sm.rounded-4.mb-4
          .card-body.p-4.text-center
            .rounded-circle.bg-dark.text-white.d-flex.align-items-center.justify-content-center.mx-auto.mb-3(
              style="width:96px;height:96px;"
            )
              span.fs-1.fw-bold= dashboard.user.username[0].toUpperCase()

            h1.h4.fw-bold.mb-1= dashboard.user.username
            p.text-muted.mb-1= dashboard.user.email
            span.badge.text-bg-light= dashboard.user.role

        .card.border-0.shadow-sm.rounded-4
          .card-body.p-4
            h2.h6.fw-bold.text-uppercase.text-muted.mb-3 Estadísticas

            .d-flex.justify-content-between.mb-2
              span Publicaciones
              strong= dashboard.totalPosts

            .d-flex.justify-content-between.mb-2
              span Seguidores
              strong= dashboard.followersCount

            .d-flex.justify-content-between.mb-2
              span Seguidos
              strong= dashboard.followingCount

            .d-flex.justify-content-between
              span Denuncias recibidas
              strong.text-danger= dashboard.totalReports

      .col-12.col-lg-8
        .d-flex.justify-content-between.align-items-center.mb-3
          h2.h4.fw-bold.mb-0 Administrar publicaciones
          a.btn.btn-fotaza.rounded-pill.px-4(href="/posts/create") Nueva publicación

        if dashboard.posts.length
          each post in dashboard.posts
            .card.border-0.shadow-sm.rounded-4.mb-3
              .card-body.p-3
                .d-flex.gap-3
                  if post.image
                    img.rounded-3.object-fit-cover(
                      src=post.image
                      alt=post.title
                      style="width:96px;height:96px;"
                    )

                  .flex-grow-1
                    .d-flex.justify-content-between.align-items-start
                      div
                        h3.h6.fw-bold.mb-1= post.title
                        small.text-muted= post.createdAt

                      if post.reportsCount > 0
                        span.badge.text-bg-danger #{post.reportsCount} denuncias
                      else
                        span.badge.text-bg-success Sin denuncias

                    if post.description
                      p.text-muted.small.mt-2.mb-2= post.description

                    if post.reportsCount > 0
                      .alert.alert-warning.rounded-3.py-2.px-3.mb-0
                        each report in post.reports
                          .mb-2
                            strong= report.reason
                            if report.description
                              span.ms-2= report.description
                            div
                              small.text-muted= report.createdAt
        else
          .card.border-0.shadow-sm.rounded-4
            .card-body.text-center.p-5
              p.text-muted.mb-3 Todavía no creaste publicaciones.
              a.btn.btn-fotaza.rounded-pill.px-4(href="/posts/create") Crear publicación