doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title= title

    link(
      href="/bootstrap/css/bootstrap.min.css"
      rel="stylesheet"
    )

    link(
      rel="stylesheet"
      href="/toastify/toastify.css"
    )

    link(
      rel="stylesheet"
      href="/css/global.css"
    )

    block styles

  body.bg-light

    include ../../components/navbar

    block content

    include ../../components/toasters

    script(src="/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/toastify/toastify.js")