doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")

    title= title

    link(
      href="/bootstrap/css/bootstrap.min.css"
      rel="stylesheet"
    )

    link(
      rel="stylesheet"
      href="/toastify/toastify.css"
    )

  body.bg-light

    block content

    script(src="/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/toastify/toastify.js")

    if successMessage
      script.
        Toastify({
          text: "!{successMessage}",
          duration: 3000,
          gravity: "top",
          position: "right",
          style: {
            background: "#198754"
          }
        }).showToast()

    if errorMessage
      script.
        Toastify({
          text: "!{errorMessage}",
          duration: 4000,
          gravity: "top",
          position: "right",
          style: {
            background: "#dc3545"
          }
        }).showToast()