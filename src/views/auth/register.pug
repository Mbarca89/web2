doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= title
        script(src="/bootstrap/js/bootstrap.bundle.min.js")
        script(src="/toastify/toastify.js")
        link(
            href="/bootstrap/css/bootstrap.min.css"
            rel="stylesheet"
        )
        link(rel="stylesheet" href="/toastify/toastify.css")

    body.bg-light
        main.container
            .row.justify-content-center.align-items-center.min-vh-100
                .col-12.col-md-6.col-lg-4
                    .card.shadow-sm.border-0.rounded-4
                        .card-body.p-4
                            h1.h3.text-center.mb-4 Crear cuenta

                            form(action="/auth/register" method="POST")
                                .mb-3
                                    label.form-label(for="username") Usuario
                                    input.form-control(
                                        class=fieldErrors.username ? "is-invalid" : ""
                                        type="text"
                                        id="username"
                                        name="username"
                                        value=oldData.username || ""
                                        placeholder="Usuario"
                                    )
                                    if fieldErrors.username
                                        .invalid-feedback= fieldErrors.username

                                .mb-3
                                    label.form-label(for="email") Email
                                    input.form-control(
                                        class=fieldErrors.email ? "is-invalid" : ""
                                        type="email"
                                        id="email"
                                        name="email"
                                        value=oldData.email || ""
                                        placeholder="tu@email.com"
                                    )
                                    if fieldErrors.email
                                        .invalid-feedback= fieldErrors.email

                                .mb-3
                                    label.form-label(for="password") Contraseña
                                    input.form-control(
                                        class=fieldErrors.password ? "is-invalid" : ""
                                        type="password"
                                        id="password"
                                        name="password"
                                        placeholder="Mínimo 6 caracteres"
                                    )
                                    if fieldErrors.password
                                        .invalid-feedback= fieldErrors.password

                                .mb-3
                                    label.form-label(for="confirmPassword") Confirmar contraseña
                                    input.form-control(
                                        class=fieldErrors.confirmPassword ? "is-invalid" : ""
                                        type="password"
                                        id="confirmPassword"
                                        name="confirmPassword"
                                    )
                                    if fieldErrors.confirmPassword
                                        .invalid-feedback= fieldErrors.confirmPassword

                                button.btn.btn-primary.w-100(type="submit") Registrarme

                                p.text-center.mt-3.mb-0
                                        | ¿Ya tenes una cuenta?
                                        a.ms-1(href="/auth/login") Iniciar sesion

if errorMessage
    script.
        Toastify({
            text: "#{errorMessage}",
            duration: 4000,
            gravity: "top",
            position: "center",
            style: {
                background: "#dc3545"
            }
        }).showToast()

if successMessage
    script.
        Toastify({
            text: "#{successMessage}",
            duration: 3000,
            gravity: "top",
            position: "center",
            style: {
                background: "#198754"
            }
        }).showToast()