extends ../layouts/main

block content
    body.bg-light
        main.container
            .row.justify-content-center.align-items-center.min-vh-100
                .col-12.col-md-6.col-lg-4
                    .card.shadow-sm.border-0.rounded-4
                        .card-body.p-4
                            h1.h3.text-center.mb-4 Crear cuenta

                            form(action="/auth/register" method="POST")
                                .mb-3
                                    label.form-label(for="username") Usuario
                                    input.form-control(
                                        class=fieldErrors.username ? "is-invalid" : ""
                                        type="text"
                                        id="username"
                                        name="username"
                                        value=oldData.username || ""
                                        placeholder="Usuario"
                                    )
                                    if fieldErrors.username
                                        .invalid-feedback= fieldErrors.username

                                .mb-3
                                    label.form-label(for="email") Email
                                    input.form-control(
                                        class=fieldErrors.email ? "is-invalid" : ""
                                        type="email"
                                        id="email"
                                        name="email"
                                        value=oldData.email || ""
                                        placeholder="tu@email.com"
                                    )
                                    if fieldErrors.email
                                        .invalid-feedback= fieldErrors.email

                                .mb-3
                                    label.form-label(for="password") Contraseña
                                    input.form-control(
                                        class=fieldErrors.password ? "is-invalid" : ""
                                        type="password"
                                        id="password"
                                        name="password"
                                        placeholder="Mínimo 6 caracteres"
                                    )
                                    if fieldErrors.password
                                        .invalid-feedback= fieldErrors.password

                                .mb-3
                                    label.form-label(for="confirmPassword") Confirmar contraseña
                                    input.form-control(
                                        class=fieldErrors.confirmPassword ? "is-invalid" : ""
                                        type="password"
                                        id="confirmPassword"
                                        name="confirmPassword"
                                    )
                                    if fieldErrors.confirmPassword
                                        .invalid-feedback= fieldErrors.confirmPassword

                                button.btn-fotaza.w-100(type="submit") Registrarme

                                p.text-center.mt-3.mb-0
                                        | ¿Ya tenes una cuenta?
                                        a.ms-1(href="/auth/login") Iniciar sesion
