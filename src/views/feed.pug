extends layouts/main

block content
  main.container.py-5
    form.mb-4(action="/feed" method="GET")
      .row.g-2
        .col-12.col-md-5
          input.form-control(
            type="text"
            name="q"
            placeholder="Buscar publicaciones..."
            value=filters.q || ""
          )

        .col-12.col-md-3
          select.form-select(name="license")
            option(value="") Todas las licencias
            option(value="FREE" selected=filters.license === "FREE") Sin copyright
            option(value="COPYRIGHT" selected=filters.license === "COPYRIGHT") Con copyright

        .col-12.col-md-2
          button.btn.btn-fotaza.w-100(type="submit") Buscar

        .col-12.col-md-2
          a.btn.btn-fotaza-outline.w-100(href="/feed") Limpiar
    .row.justify-content-center
      .col-12.col-md-8.col-lg-5
        each post in posts
          include /components/postCard
    .modal.fade#ratingModal(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        .modal-content.rounded-4.border-0
          .modal-header
            h5.modal-title Valorar publicación
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")

          .modal-body
            p.text-muted.mb-3 Elegí una valoración del 1 al 5.
            input#ratingPostId(type="hidden")

            select#ratingValue.form-select
              option(value="1") 1 estrella
              option(value="2") 2 estrellas
              option(value="3") 3 estrellas
              option(value="4") 4 estrellas
              option(value="5" selected) 5 estrellas

          .modal-footer
            button.btn.btn-fotaza-outline.rounded-pill(type="button" data-bs-dismiss="modal") Cancelar
            button#submitRatingBtn.btn.btn-fotaza.rounded-pill(type="button") Guardar valoración

    script(src="/js/feedInteractions.js")