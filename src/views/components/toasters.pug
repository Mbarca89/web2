if successMessage
    script.
        Toastify({
            text: "!{successMessage}",
            duration: 3000,
            gravity: "top",
            position: "center",
            style: {
                background: "#198754"
            }
        }).showToast()

if errorMessage
    script.
        Toastify({
            text: "!{errorMessage}",
            duration: 4000,
            gravity: "top",
            position: "center",
            style: {
                background: "#dc3545"
            }
        }).showToast()